<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <!-- Top row: Category and Streak badge -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_category"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DAILY AFFIRMATION • AVAN"
            android:textColor="#8B7355"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/widget_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 12 Days"
            android:textColor="#C4956A"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Center: Quote -->
    <TextView
        android:id="@+id/widget_quote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_header"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:text="&quot;I attract peace, abundance, and clarity into my life every single day.&quot;"
        android:textColor="#3D2C1E"
        android:textSize="14sp"
        android:lineSpacingMultiplier="1.2"
        android:textStyle="italic" />

    <!-- Bottom: Author / Mood -->
    <TextView
        android:id="@+id/widget_author"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:text="Mindset &amp; Emotional Presence"
        android:textColor="#B5A08A"
        android:textSize="10sp" />

</RelativeLayout>
